# Copy to .env.local (never commit real values).

# Public origin of the deployed site, used for CSRF origin checks and metadata.
NEXT_PUBLIC_SITE_URL=https://atlanticgems.ca

# Trade-area gate. Generate the hash with:
#   node -e "console.log(require('crypto').createHash('sha256').update('your-passphrase').digest('hex'))"
WHOLESALE_PASSWORD_SHA256=
# 32+ random bytes, hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Session lifetime in hours (default 12).
WHOLESALE_SESSION_HOURS=12

# Inventory admin. Generate the hash with:  node scripts/hash-password.mjs
# In /etc/atlantic-gems/production.env, or anything else a process manager
# loads (PM2 --env-file, systemd EnvironmentFile), use the FIRST line it
# prints, with plain $. Only in the .env files in clean/ that Next.js itself
# reads (.env, .env.local, .env.production), use the second line, with each $ written \$.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=8
# Where inventory.json, settings.json, parts.json, the crm/ files and uploaded
# images live. Use an absolute, persistent, backed-up path outside the deploy
# directory. It must be absolute: the standalone server (.next/standalone/
# server.js) runs from .next/standalone, so a relative path such as ./data
# ends up inside the build output, which the next build replaces, taking the
# data with it. For local development delete this line: the app then uses
# data/ in its working directory.
DATA_DIR=/var/lib/atlantic-gems

# eBay import (optional). Create an application at developer.ebay.com; the
# client-credentials grant needs no user login. Seller username is the eBay
# account whose active listings should be imported.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SELLER_USERNAME=
EBAY_MARKETPLACE_ID=EBAY_CA
# EBAY_ENV=sandbox for testing against the sandbox

# Future payments (stubbed until enabled). Card checkout UI is wired.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Future shipping rates (stubbed).
# SHIPPING_API_KEY=

# Future accounting sync (stubbed).
# ACCOUNTING_API_KEY=

# Enquiry delivery. Configure ONE of the following. If neither is set the form
# still creates a CRM lead; email delivery is skipped.
# Option A: Resend (https://resend.com) API key, plus verified from/to addresses.
RESEND_API_KEY=
CONTACT_FROM=Atlantic Gems <enquiries@atlanticgems.ca>
CONTACT_TO=support@atlanticgems.ca
# Option B: any HTTPS webhook that accepts a JSON POST (CRM, Zapier, Make, etc.).
CONTACT_WEBHOOK_URL=

# Acknowledgement emails to the customer after a quote request or an enquiry.
# Keep this false until the client approves the wording in lib/mail.ts
# (deliverQuoteAcknowledgement, deliverEnquiryAcknowledgement). Sent through
# Resend only, so it also needs RESEND_API_KEY; the webhook cannot email customers.
CUSTOMER_ACK_EMAIL=false

# Optional, scan-time only (not read by the app). Comma-separated strings that
# must never appear on a public page, e.g. the private street address.
PRIVATE_STRINGS=

# Set to "true" only when the app is reachable solely through a reverse proxy that
# APPENDS the connecting address to X-Forwarded-For (nginx $proxy_add_x_forwarded_for,
# Caddy, Vercel). Only the right-most entry is used; anything to its left is
# client-supplied. When false, no proxy header is trusted and each rate limit is
# one shared bucket. Used for rate limiting only.
TRUST_PROXY=false

# Number of trusted proxies that each append to X-Forwarded-For (e.g. 2 for
# Cloudflare in front of nginx). Default 1. More than 1 is safe ONLY while the
# origin (nginx) accepts connections solely from the outer proxy's published
# address ranges: a client reaching nginx directly writes the entry the app
# reads and is never limited. Otherwise keep 1 and have nginx take the client
# address from the outer proxy (set_real_ip_from + real_ip_header). See the
# rate-limit checklist in docs/DEPLOY.md.
TRUST_PROXY_HOPS=1
